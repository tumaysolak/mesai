PORT=3000
DATABASE_PATH=data/mesai.db
ADMIN_TOKEN=replace-with-a-long-random-owner-token
# Optional. Without a key, the UI explicitly shows rule-based simulation mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PHASE_DELAY_MS=9000
MAX_DAILY_AI_CALLS=22
# Ziyaretcilerin gunluk isleri icin model harcama tavani (USD).
VISITOR_DAILY_BUDGET_USD=0.25
# Bulten icin Resend. Anahtar yoksa kayit alinir, e-posta gonderilmez.
RESEND_API_KEY=
MAIL_FROM=MESAI <bulten@mesailabs.com>
PUBLIC_URL=https://mesailabs.com
